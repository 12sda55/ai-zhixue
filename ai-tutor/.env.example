# AI Tutor - 个性化资源生成与学习多智能体系统
# 复制此文件为 .env 并填入实际值

# ==================== LLM 配置 ====================

# DeepSeek API（主模型）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 讯飞星火API（备选模型 / Manim视频TTS旁白生成）
XUNFEI_APP_ID=your_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret
XUNFEI_SPARK_URL=wss://spark-api.xf-yun.com/v4/chat
XUNFEI_SPARK_MODEL=4.0Ultra

# LLM主模型切换（对照规范 9.1：双模型可切换）
LLM_PRIMARY=deepseek          # 主模型: "deepseek" | "spark"
LLM_SECONDARY=deepseek        # 备选模型
LLM_FALLBACK_ENABLED=true     # 主模型不可用时自动切换备选

# ==================== 数据库配置 ====================

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=ai_tutor

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ChromaDB（向量知识库持久化目录）
CHROMA_PERSIST_DIR=./data/chroma_db

# ==================== 代码沙箱 ====================

# Judge0（在线代码执行引擎）
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# ==================== 应用配置 ====================

# 服务监听
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# 安全密钥（生产环境必须修改）
APP_SECRET_KEY=your_secret_key_change_in_production

# CORS允许的来源（对照规范 E3：严禁配置为 *）
# Docker部署时设为前端域名，如 http://your-domain.com
CORS_ORIGIN=

# ==================== 视频生成 ====================

# 豆包 Seedance 视频生成（主Provider）
# 注册: https://www.volcengine.com/  注册即送200万tokens免费额度
# 定价: Seedance Lite ~0.5元/条5秒视频
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com

# 视频生成Provider降级链（逗号分隔，按优先级排列）
# seedance: 豆包AI视频生成（需API Key）
# manim: Manim程序化动画（需本地安装Manim）
VIDEO_PROVIDER_ORDER=seedance,manim

# ==================== 对象存储（可选） ====================

# 用于视频/代码分享等文件存储
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=ai-tutor
